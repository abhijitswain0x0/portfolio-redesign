---

<header class="site-nav">
  <div class="nav-inner">
    <a class="name" href="/"><span class="prompt">~$</span> abhijit swain</a>
    <nav class="links" aria-label="Sections">
      <a href="/#projects">projects</a>
      <a href="/blogs/">writing</a>
      <a href="/#contact">contact</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--faint);
    /* Keep the bar clear of notches and camera holes */
    padding-top: env(safe-area-inset-top);
    /* Own compositor layer: stops WebKit repainting the bar a frame late
       during scroll and rubber-band snap-back on iOS */
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 13px;
    padding-bottom: 13px;
    padding-left: calc(20px + env(safe-area-inset-left));
    padding-right: calc(20px + env(safe-area-inset-right));
    font-family: var(--mono);
    font-size: 13px;
  }

  .name {
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    color: var(--fg);
  }

  .prompt {
    color: var(--accent-text);
    font-weight: 400;
  }

  .links a {
    color: var(--dim);
    text-decoration: none;
    margin-left: 16px;
  }

  .links a:hover {
    color: var(--accent-text);
  }

  @media (max-width: 480px) {
    .links a {
      margin-left: 12px;
    }
  }
</style>
