---

---

<header class="site-nav">
  <div class="nav-inner">
    <a class="name" href="/">Abhijit Swain</a>
    <button class="theme-toggle" type="button" aria-label="switch theme">
      <svg viewBox="0 0 24 24" width="17.25" height="17.25" aria-hidden="true">
        <mask id="moon-cutout">
          <rect width="24" height="24" fill="white"></rect>
          <circle class="cutout" cx="26" cy="-2" r="4.2" fill="black"></circle>
        </mask>
        <circle
          class="core"
          cx="12"
          cy="12"
          r="5"
          fill="currentColor"
          mask="url(#moon-cutout)"
        ></circle>
        <g
          class="rays"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="12" y1="1.5" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22.5"></line>
          <line x1="1.5" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22.5" y2="12"></line>
          <line x1="4.6" y1="4.6" x2="6.4" y2="6.4"></line>
          <line x1="17.6" y1="17.6" x2="19.4" y2="19.4"></line>
          <line x1="4.6" y1="19.4" x2="6.4" y2="17.6"></line>
          <line x1="17.6" y1="6.4" x2="19.4" y2="4.6"></line>
        </g>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--faint);
    /* Keep the bar clear of notches and camera holes */
    padding-top: env(safe-area-inset-top);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    padding-top: 13px;
    padding-bottom: 13px;
    padding-left: calc(20px + env(safe-area-inset-left));
    padding-right: calc(20px + env(safe-area-inset-right));
    font-family: var(--heading);
    font-size: 13px;
  }

  .name {
    display: inline-block;
    padding: 8px 0;
    margin: -8px 0;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    color: var(--accent-text);
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector(".theme-toggle");
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const savedTheme = () => {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  };
  const currentTheme = () =>
    root.dataset.theme || (darkQuery.matches ? "dark" : "light");

  function applyTheme(theme, persist) {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem("theme", theme);
      } catch {}
    }
    toggle?.setAttribute(
      "aria-label",
      theme === "dark" ? "switch to light mode" : "switch to dark mode",
    );
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((m) => m.remove());
    const meta = document.createElement("meta");
    meta.name = "theme-color";
    meta.content = theme === "dark" ? "#000000" : "#ffffff";
    document.head.appendChild(meta);
  }

  applyTheme(currentTheme(), false);

  // Pixel wipe theme switch (demo). A staircase edge of square pixels sweeps
  // diagonally across the screen: dark to light wipes from the top-left corner
  // to the bottom-right, light to dark wipes back from the bottom-right to the
  // top-left. The mask sprite is drawn once per direction; each switch only
  // slides it with a compositor animation, so it stays smooth.
  const CELL = 24;
  const DURATION = 1700;
  const sprites = {};

  function buildSprite(down) {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const L = Math.ceil(w / CELL) + Math.ceil(h / CELL) + 6;
    const canvas = document.createElement("canvas");
    canvas.width = L * CELL;
    canvas.height = L * CELL;
    const ctx = canvas.getContext("2d");
    if (!down) {
      // same shape rotated half a turn, so the solid side faces bottom-right
      ctx.translate(canvas.width, canvas.height);
      ctx.rotate(Math.PI);
    }
    ctx.fillStyle = "#000";
    // solid body up to the diagonal, then a noisy band of random pixels
    // (denser on the inside, sparser on the outside) as the leading edge
    for (let r = 0; r < L; r++) {
      const edge = L - 1 - r;
      ctx.fillRect(0, r * CELL, Math.max(0, edge - 4) * CELL, CELL);
      for (let c = Math.max(0, edge - 4); c <= edge + 4; c++) {
        if (c >= L) break;
        const t = Math.min(1, Math.max(0, (edge - c + 4.5) / 9));
        const p = t * t * (3 - 2 * t);
        if (Math.random() < p) ctx.fillRect(c * CELL, r * CELL, CELL, CELL);
      }
    }
    return { url: canvas.toDataURL(), size: L * CELL, w, h };
  }

  toggle?.addEventListener("click", () => {
    const next = currentTheme() === "dark" ? "light" : "dark";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduced) {
      applyTheme(next, true);
      return;
    }
    // dark -> light sweeps down, light -> dark sweeps up
    const down = next === "light";
    let sp = sprites[down];
    if (!sp || sp.w !== window.innerWidth || sp.h !== window.innerHeight) {
      sp = sprites[down] = buildSprite(down);
    }
    const { size } = sp;
    const from = down ? `${-size}px ${-size}px` : `${sp.w}px ${sp.h}px`;
    const to = down ? `0px 0px` : `${sp.w - size}px ${sp.h - size}px`;
    const style = document.createElement("style");
    style.textContent = `::view-transition-new(root){-webkit-mask-image:url(${sp.url});mask-image:url(${sp.url});-webkit-mask-size:${size}px ${size}px;mask-size:${size}px ${size}px;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:${from};mask-position:${from}}`;
    document.head.appendChild(style);
    const transition = document.startViewTransition(() => {
      applyTheme(next, true);
    });
    transition.ready
      .then(() => {
        document.documentElement.animate(
          { maskPosition: [from, to], webkitMaskPosition: [from, to] },
          {
            duration: DURATION,
            easing: "cubic-bezier(0.5, 0, 0.2, 1)",
            fill: "both",
            pseudoElement: "::view-transition-new(root)",
          },
        );
      })
      .catch(() => {});
    transition.finished.finally(() => {
      style.remove();
      // draw a fresh random edge for next time, off the critical path
      delete sprites[down];
      setTimeout(() => {
        sprites[down] = buildSprite(down);
      }, 200);
    });
  });

  // Follow OS theme changes while the page is open, unless a theme was picked
  // manually. System changes stay instant - no animation, not persisted.
  darkQuery.addEventListener("change", (event) => {
    const saved = savedTheme();
    if (saved !== "light" && saved !== "dark") {
      applyTheme(event.matches ? "dark" : "light", false);
    }
  });

  // Prebuild both wipe sprites during idle time so the first switch does not
  // draw on the click path.
  const warmSprites = () => {
    if (!document.startViewTransition) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    for (const d of [true, false]) {
      const s = sprites[d];
      if (!s || s.w !== window.innerWidth || s.h !== window.innerHeight) {
        sprites[d] = buildSprite(d);
      }
    }
  };
  (window.requestIdleCallback || ((cb) => setTimeout(cb, 500)))(warmSprites);
</script>
