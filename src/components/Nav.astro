<header class="site-nav">
  <div class="nav-inner">
    <a class="name" href="/">abhijit swain</a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--faint);
    /* Keep the bar clear of notches and camera holes */
    padding-top: env(safe-area-inset-top);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: baseline;
    padding-top: 13px;
    padding-bottom: 13px;
    padding-left: calc(20px + env(safe-area-inset-left));
    padding-right: calc(20px + env(safe-area-inset-right));
    font-family: var(--mono);
    font-size: 13px;
  }

  .name {
    display: inline-block;
    padding: 8px 0;
    margin: -8px 0;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    color: var(--fg);
  }
</style>
