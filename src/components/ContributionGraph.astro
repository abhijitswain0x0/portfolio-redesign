---
// Public GitHub contributions for the last 120 days, fetched at build time.
// If the fetch fails the section is simply left out.
const USER = "abhijitswain0x0";
const DAYS = 120;

type Day = { date: string; level: number; count: number };

async function load(): Promise<Day[] | null> {
  try {
    const res = await fetch(`https://github.com/users/${USER}/contributions`);
    if (!res.ok) return null;
    const html = await res.text();
    const tips = new Map<string, string>();
    for (const m of html.matchAll(/for="([^"]+)"[^>]*>([^<]*)</g)) tips.set(m[1], m[2]);
    const days: Day[] = [];
    for (const m of html.matchAll(/<td[^>]*data-date="([\d-]+)"[^>]*id="([^"]+)"[^>]*data-level="(\d)"/g)) {
      const n = /^(\d+) contribution/.exec(tips.get(m[2]) ?? "");
      days.push({ date: m[1], level: Number(m[3]), count: n ? Number(n[1]) : 0 });
    }
    days.sort((a, b) => a.date.localeCompare(b.date));
    return days.length ? days.slice(-DAYS) : null;
  } catch {
    return null;
  }
}

const days = await load();
let weeks: (Day | null)[][] = [];
let total = 0;
let months: string[] = [];

if (days) {
  total = days.reduce((s, d) => s + d.count, 0);
  const byDate = new Map(days.map((d) => [d.date, d]));
  const first = new Date(days[0].date + "T00:00:00Z");
  const last = new Date(days[days.length - 1].date + "T00:00:00Z");
  const start = new Date(first);
  start.setUTCDate(start.getUTCDate() - start.getUTCDay());
  for (let d = new Date(start); d <= last; d.setUTCDate(d.getUTCDate() + 7)) {
    const week: (Day | null)[] = [];
    for (let i = 0; i < 7; i++) {
      const c = new Date(d);
      c.setUTCDate(c.getUTCDate() + i);
      week.push(byDate.get(c.toISOString().slice(0, 10)) ?? null);
    }
    weeks.push(week);
  }
  let prev = -1;
  months = weeks.map((w, i) => {
    const m = new Date(start.getTime() + i * 7 * 86400000).getUTCMonth();
    const label = m !== prev && i > 0 ? new Date(Date.UTC(2000, m, 1)).toLocaleString("en", { month: "short", timeZone: "UTC" }) : "";
    prev = m;
    return label;
  });
}
---

{
  days && (
    <section id="activity">
      <h2 class="section-label">
        Activity <span class="count">{total}</span>
      </h2>
      <div class="cg" role="img" aria-label={`${total} GitHub contributions in the last 120 days`}>
        <div class="cg-months" style={`--weeks:${weeks.length}`}>
          {months.map((m) => <span>{m}</span>)}
        </div>
        <div class="cg-grid" style={`--weeks:${weeks.length}`}>
          {weeks.map((w) => (
            <div class="cg-week">
              {w.map((d) => (
                <i class={d ? `l${d.level}` : "empty"} title={d ? `${d.count} on ${d.date}` : undefined} />
              ))}
            </div>
          ))}
        </div>
        <div class="cg-meta">
          <span>{total} contributions, last 120 days</span>
          <span class="cg-legend">
            Less
            <i class="l0" />
            <i class="l1" />
            <i class="l2" />
            <i class="l3" />
            <i class="l4" />
            More
          </span>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  .cg {
    --l0: #eef3f8;
    --l1: #cfe3f5;
    --l2: #9cc8ec;
    --l3: #6aa7d8;
    --l4: #3f74a8;
    --gap: 4px;
    width: 100%;
    overflow: hidden;
    padding-top: 6px;
  }
  @media (prefers-color-scheme: dark) {
    .cg {
      --l0: #1c2229;
      --l1: #27455f;
      --l2: #3f6f96;
      --l3: #7fb0d8;
      --l4: #bfe0f7;
    }
  }
  html[data-theme="light"] .cg {
    --l0: #eef3f8;
    --l1: #cfe3f5;
    --l2: #9cc8ec;
    --l3: #6aa7d8;
    --l4: #3f74a8;
  }
  html[data-theme="dark"] .cg {
    --l0: #1c2229;
    --l1: #27455f;
    --l2: #3f6f96;
    --l3: #7fb0d8;
    --l4: #bfe0f7;
  }
  #activity .section-label .count {
    color: var(--accent-text);
  }
  .cg-months,
  .cg-grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    gap: var(--gap);
  }
  .cg-months {
    font-size: 11px;
    color: var(--dim);
    margin-bottom: 5px;
    line-height: 1.2;
  }
  .cg-months span {
    white-space: nowrap;
    overflow: visible;
  }
  .cg-week {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: repeat(7, auto);
    gap: var(--gap);
  }
  .cg i {
    display: block;
    aspect-ratio: 1;
    border-radius: 25%;
  }
  .cg i.empty {
    background: none;
  }
  .cg i.l0 { background: var(--l0); }
  .cg i.l1 { background: var(--l1); }
  .cg i.l2 { background: var(--l2); }
  .cg i.l3 { background: var(--l3); }
  .cg i.l4 { background: var(--l4); }
  .cg-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
    font-size: 11px;
    color: var(--dim);
  }
  .cg-legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
  }
  .cg-legend i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
</style>
