---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout title="Abhijit Swain">
  <Nav />
  <main class="wrap">
    <div class="intro">
      <picture class="me">
        <source
          srcset="/me-dark.svg"
          media="(prefers-color-scheme: dark)"
        />
        <img
          src="/me-light.svg"
          alt="Abhijit Swain"
          width="384"
          height="384"
        />
      </picture>
      <div class="intro-text">
        <p>
          Student developer based in Odisha, India, leading Team Origin Logic. I
          build clean, fast software with interfaces that get out of the way.
        </p>
        <div class="status">not available for work</div>
      </div>
    </div>

    <section id="projects">
      <h2 class="section-label">projects <span class="count">2</span></h2>
      <ul class="rows">
        <li>
          <div class="row">
            <span class="t">GitPal</span>
            <span class="d"
              >Visual Git wrapper that makes branches, commits and merges
              readable, with real-time collaboration</span
            >
          </div>
        </li>
        <li>
          <div class="row">
            <span class="t">Blink</span>
            <span class="d"
              >Lightweight desktop AI utility with a Raycast-like floating
              window</span
            >
          </div>
        </li>
      </ul>
    </section>

    <section id="contact">
      <h2 class="section-label">contact <span class="count">2</span></h2>
      <ul class="rows">
        <li>
          <button
            class="row copy-email"
            type="button"
            data-email="abhijitswain0x0@proton.me"
          >
            <span class="t">abhijitswain0x0@proton.me</span>
            <span class="d">click to copy</span>
          </button>
        </li>
        <li>
          <a
            class="row"
            href="https://signal.me/#eu/sckfK5kPIaXFR8fxmjEN99mWRlwajR_ZMbNJ9_jiS5cyimL-yZJPrpLx5oLoRrRX"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="t">Signal</span>
            <span class="d">signal.me</span>
          </a>
        </li>
      </ul>
    </section>

    <section id="social">
      <h2 class="section-label">social <span class="count">2</span></h2>
      <ul class="rows">
        <li>
          <a
            class="row"
            href="https://x.com/abhijitswain0x0"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="t">Twitter</span>
            <span class="d">@abhijitswain0x0</span>
          </a>
        </li>
        <li>
          <a
            class="row"
            href="https://github.com/abhijitswain0x0"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="t">GitHub</span>
            <span class="d">abhijitswain0x0</span>
          </a>
        </li>
      </ul>
    </section>
  </main>

  <div class="copy-toast" role="status">copied to clipboard</div>

  <script>
    const copyBtn = document.querySelector(".copy-email");
    const toast = document.querySelector(".copy-toast");
    let hideTimer;
    copyBtn?.addEventListener("click", async () => {
      const email = copyBtn.getAttribute("data-email") || "";
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      toast?.classList.add("show");
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => toast?.classList.remove("show"), 1600);
    });
  </script>
</BaseLayout>
